---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { books, loadBook } from '../../lib/books';
import { withBase } from '../../lib/site';

export function getStaticPaths() { return books.map((book) => ({ params: { slug: book.slug } })); }
const { slug } = Astro.params;
const book = await loadBook(slug!);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={book.meta.title} description={book.meta.description}>
  <div class="reading-progress" aria-hidden="true"><span id="progress-bar"></span></div>
  <header class="reader-mast shell">
    <a class="back-link" href={withBase(base, 'referensi/')}>← Kembali ke referensi</a>
    <p class="kicker">{book.meta.eyebrow}</p>
    <p class="reader-display-title">{book.meta.title}</p>
    <div class="reader-meta"><span>{book.words.toLocaleString('id-ID')} kata</span><span>± {book.minutes} menit</span><span id="progress-label">Belum dibaca</span></div>
  </header>
  <div class="reader-shell shell">
    <aside class="reader-aside"><TableOfContents chapters={book.chapters} /></aside>
    <aside class="reader-tools" aria-label="Pengaturan baca">
      <div><button id="font-down" type="button" aria-label="Perkecil teks">A−</button><button id="font-up" type="button" aria-label="Perbesar teks">A+</button></div>
      <a href="#main-content" aria-label="Kembali ke atas">↑</a>
    </aside>
    <article class="prose" id="book-content" data-slug={book.meta.slug} set:html={book.html} />
  </div>
  <details class="mobile-toc shell"><summary>Daftar isi <span>{book.chapters.length} bagian</span></summary><TableOfContents chapters={book.chapters} /></details>
  <nav class="chapter-nav shell" aria-label="Navigasi bagian">
    <a id="chapter-prev" href="#" hidden><span>Bagian sebelumnya</span><strong></strong></a>
    <a id="chapter-next" href="#" hidden><span>Bagian berikutnya</span><strong></strong></a>
  </nav>
  <section class="reader-end shell"><p class="kicker">Sampai di sini</p><h2>Catatan terbaik adalah yang kembali dibaca.</h2><a href={withBase(base, 'referensi/')}>Lihat referensi lain →</a></section>
  <script is:inline define:vars={{ chapters: book.chapters, slug: book.meta.slug }}>
    const article = document.querySelector('#book-content');
    const bar = document.querySelector('#progress-bar'); const label = document.querySelector('#progress-label');
    const prev = document.querySelector('#chapter-prev'); const next = document.querySelector('#chapter-next');
    let activeIndex = 0;
    function updateChapterNav(index) {
      activeIndex = Math.max(0, index);
      const before = chapters[activeIndex - 1]; const after = chapters[activeIndex + 1];
      if (before) { prev.hidden = false; prev.href = `#${before.id}`; prev.querySelector('strong').textContent = before.title; } else prev.hidden = true;
      if (after) { next.hidden = false; next.href = `#${after.id}`; next.querySelector('strong').textContent = after.title; } else next.hidden = true;
    }
    const headings = chapters.map((chapter) => document.getElementById(chapter.id)).filter(Boolean);
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) if (entry.isIntersecting) {
        const index = chapters.findIndex((chapter) => chapter.id === entry.target.id); updateChapterNav(index);
        document.querySelectorAll('.toc a').forEach((a) => a.removeAttribute('aria-current'));
        document.querySelectorAll(`.toc a[href="#${entry.target.id}"]`).forEach((a) => a.setAttribute('aria-current', 'location'));
      }
    }, { rootMargin: '-15% 0px -70%' }); headings.forEach((heading) => observer.observe(heading)); updateChapterNav(0);
    let ticking = false;
    function saveProgress() {
      const rect = article.getBoundingClientRect(); const available = Math.max(1, article.offsetHeight - innerHeight);
      const percent = Math.min(100, Math.max(0, Math.round((-rect.top / available) * 100)));
      bar.style.width = `${percent}%`; label.textContent = percent ? `${percent}% dibaca` : 'Belum dibaca';
      try { localStorage.setItem(`pustaka:progress:${slug}`, JSON.stringify({ percent, chapterId: chapters[activeIndex]?.id || '' })); } catch {}
      ticking = false;
    }
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(saveProgress); } }, { passive: true }); saveProgress();
    const setScale = (delta) => { try { const old = JSON.parse(localStorage.getItem('pustaka:preferences') || '{}'); const value = Math.min(1.2, Math.max(.9, Number(old.fontScale || 1) + delta)); document.documentElement.style.setProperty('--font-scale', String(value)); localStorage.setItem('pustaka:preferences', JSON.stringify({ ...old, fontScale: value })); } catch { const current = Number.parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--font-scale')) || 1; document.documentElement.style.setProperty('--font-scale', String(Math.min(1.2, Math.max(.9, current + delta)))); } };
    document.querySelector('#font-down')?.addEventListener('click', () => setScale(-.1)); document.querySelector('#font-up')?.addEventListener('click', () => setScale(.1));
    const mobileToc = document.querySelector('.mobile-toc');
    if (mobileToc) mobileToc.querySelectorAll('.toc a').forEach((a) => a.addEventListener('click', () => { mobileToc.removeAttribute('open'); }));
  </script>
</BaseLayout>
