---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookCard from '../components/BookCard.astro';
import { books } from '../lib/books';
import catalog from '../data/fal-models.json';
import { SITE, withBase } from '../lib/site';
const base = import.meta.env.BASE_URL;
const categories = new Set(catalog.map((row) => row.category)).size;
---
<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="kicker">Pustaka digital · Catatan terbuka</p>
      <h1>Teknologi berubah cepat.<br /><em>Pemahaman</em> perlu dirawat.</h1>
      <p class="lede">{SITE.tagline} Empat buku referensi dan satu katalog model, dirapikan menjadi ruang baca yang tenang.</p>
      <div class="hero-actions">
        <a class="button" href="#koleksi">Jelajahi koleksi</a>
        <button class="button secondary" type="button" id="hero-search">Cari istilah <kbd>/</kbd></button>
      </div>
      <dl class="hero-stats">
        <div><dt>4</dt><dd>buku referensi</dd></div>
        <div><dt>{catalog.length.toLocaleString('id-ID')}</dt><dd>model Fal AI</dd></div>
        <div><dt>{categories}</dt><dd>kategori model</dd></div>
      </dl>
    </div>
    <div class="hero-art" aria-hidden="true">
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
      <div class="open-book"><span></span><span></span><i>AI</i></div>
      <span class="spark s1">✦</span><span class="spark s2">·</span><span class="spark s3">✧</span>
    </div>
  </section>

  <section id="koleksi" class="collection shell" aria-labelledby="collection-title">
    <div class="section-heading"><div><p class="kicker">Rak utama</p><h2 id="collection-title">Baca dari rasa ingin tahu</h2></div><p>Pilih referensi, lalu lanjutkan membaca dari posisi terakhir di perangkat ini.</p></div>
    <div class="book-grid">{books.map((book, index) => <BookCard book={book} index={index} />)}</div>
  </section>

  <section class="catalog-callout shell">
    <div>
      <p class="kicker">Katalog interaktif</p>
      <h2>{catalog.length.toLocaleString('id-ID')} model, tanpa menjejalkan semuanya ke layar.</h2>
      <p>Saring berdasarkan nama, deskripsi, tag, atau kategori. Hasil dibagi per halaman agar tetap ringan di perangkat kecil.</p>
      <a class="text-link" href={withBase(base, 'katalog-fal/')}>Buka katalog Fal AI <span aria-hidden="true">→</span></a>
    </div>
    <div class="catalog-motif" aria-hidden="true"><span>text</span><i>→</i><strong>model</strong><i>→</i><span>media</span></div>
  </section>

  <section class="principles shell" aria-labelledby="principles-title">
    <p class="kicker">Cara pustaka ini dirawat</p><h2 id="principles-title">Jernih, lokal, dan tidak mengintai.</h2>
    <div><article><b>01</b><h3>Catatan yang dapat ditelusuri</h3><p>Heading dan tautan dalam dibuat stabil agar setiap bagian dapat dirujuk langsung.</p></article><article><b>02</b><h3>Privasi sebagai standar</h3><p>Tema dan progres baca disimpan hanya di browser. Tanpa akun, analitik, atau pelacak.</p></article><article><b>03</b><h3>Snapshot yang jujur</h3><p>Katalog yang cepat berubah diberi tanggal akses dan konteks keterbatasannya.</p></article></div>
  </section>
  <script>
    document.querySelector('#hero-search')?.addEventListener('click', () => (document.querySelector<HTMLButtonElement>('#search-open'))?.click());
  </script>
</BaseLayout>
