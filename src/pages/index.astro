---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroNetwork from '../components/HeroNetwork.astro';
import { withBase } from '../lib/site';
import { categoriesOfGroup } from '../lib/taxonomy';
import { getTerms } from '../lib/terms';
import { categoryUrl, indexUrl, alphabetUrl, petaUrl } from '../lib/ensiklopedia';
import catalog from '../data/fal-models.json';
import snapshots from '../data/snapshots.json';

const base = import.meta.env.BASE_URL;
const terms = await getTerms();
const core = categoriesOfGroup('ai-si');
const count = (slug: string) => terms.filter((term) => term.category === slug).length;
---
<BaseLayout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="kicker">Ensiklopedia mini · Terbuka</p>
      <h1>Akal imitasi berkembang cepat. <em>Pahami</em> arahnya.</h1>
      <p class="lede">Ensiklopedia berbahasa Indonesia tentang kecerdasan buatan (AI) dan superintelligence (SI): istilah, konsep, risiko, dan arah perkembangannya.</p>
      <div class="hero-actions">
        <a class="button" href={indexUrl()}>Jelajahi ensiklopedia</a>
        <button class="button secondary" type="button" id="hero-search">Cari istilah <kbd>/</kbd></button>
      </div>
      <dl class="hero-stats">
        <div><dt>{terms.length.toLocaleString('id-ID')}</dt><dd>entri istilah</dd></div>
        <div><dt>{core.length}</dt><dd>topik inti AI dan SI</dd></div>
        <div><dt>{(snapshots.skills.count + snapshots.nous.count + catalog.length).toLocaleString('id-ID')}</dt><dd>entri referensi</dd></div>
      </dl>
    </div>
    <HeroNetwork />
  </section>

  <section id="topik" class="home-enc shell" aria-labelledby="topik-title">
    <div class="section-heading">
      <div><p class="kicker">Topik inti</p><h2 id="topik-title">Mulai dari mana saja</h2></div>
      <p>Dari dasar-dasar AI sampai pertanyaan besar tentang superintelligence. Tiap entri menyebut status tinjauan dan sumbernya.</p>
    </div>
    <ul class="cat-grid">
      {core.map((category) => {
        const total = count(category.slug);
        return (
          <li>
            {total > 0 ? (
              <a class="cat-card" href={categoryUrl(category.slug)}><strong>{category.title}</strong><p>{category.description}</p><small>{total} entri →</small></a>
            ) : (
              <div class="cat-card planned"><strong>{category.title}</strong><p>{category.description}</p><small>Sedang disusun</small></div>
            )}
          </li>
        );
      })}
    </ul>
    <p style="margin-top:1.4rem"><a class="text-link" href={alphabetUrl()}>Lihat semua {terms.length.toLocaleString('id-ID')} entri, A–Z <span aria-hidden="true">→</span></a></p>
  </section>

  <aside class="shell peta-banner" aria-labelledby="home-peta-judul">
    <div>
      <p class="kicker">Peta interaktif</p>
      <h2 id="home-peta-judul">Peta menuju superintelligence</h2>
      <p>Linimasa gagasan, model, risiko, dan kebijakan AI dari 1950 sampai 2026, bertanggal dan bersumber.</p>
    </div>
    <a class="button" href={petaUrl()}>Buka peta</a>
  </aside>

  <section class="catalog-callout shell">
    <div>
      <p class="kicker">Referensi pendukung</p>
      <h2>Hermes Agent dan katalog model</h2>
      <p>Perintah Hermes CLI, skills resmi Hermes Agent, model Nous Portal, dan {catalog.length.toLocaleString('id-ID')} model Fal AI. Semuanya snapshot bertanggal dari sumber publik.</p>
      <a class="text-link" href={withBase(base, 'referensi/')}>Buka referensi <span aria-hidden="true">→</span></a>
    </div>
    <div class="catalog-motif" aria-hidden="true"><span>teks</span><i>→</i><strong>model</strong><i>→</i><span>media</span></div>
  </section>

  <section class="principles shell" aria-labelledby="principles-title">
    <p class="kicker">Cara ensiklopedia ini dirawat</p><h2 id="principles-title">Jernih, bersumber, dan tidak mengintai.</h2>
    <div><article><b>01</b><h3>Status yang jujur</h3><p>Setiap entri menyatakan apakah ia baru catatan awal, sudah ditinjau, atau terverifikasi dengan sumber primer.</p></article><article><b>02</b><h3>Dapat dikoreksi siapa saja</h3><p>Ensiklopedia ini terbuka. Usulkan perbaikan atau laporkan kesalahan langsung dari halaman entri.</p></article><article><b>03</b><h3>Privasi sebagai standar</h3><p>Tema dan progres baca disimpan hanya di browser. Tanpa akun, analitik, atau pelacak.</p></article></div>
  </section>
  <script>
    document.querySelector('#hero-search')?.addEventListener('click', () => (document.querySelector<HTMLButtonElement>('#search-open'))?.click());
  </script>
</BaseLayout>
