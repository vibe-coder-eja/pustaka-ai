---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/peta.css';
import tonggak from '../../data/peta/tonggak.json';
import { AXIS_TICKS, TRACKS, formatMilestoneDate, placeMilestones, yearToPercent, type Milestone } from '../../lib/peta';
import { CATEGORIES, STATUS_LABELS, categoriesOfGroup, type TermStatus } from '../../lib/taxonomy';
import { getTerms } from '../../lib/terms';
import { indexUrl, termUrl } from '../../lib/ensiklopedia';
import { jsonForScript } from '../../lib/json-script';
import { SITE } from '../../lib/site';
import levelsData from '../../data/peta/levels.json';
import { COLUMN_LABELS, FRONTIER_CELL, type AgiFramework, type Column } from '../../lib/agi-levels';
import { buildGraph, layoutGraph } from '../../lib/graph';
import { GROUPS, getCategory, type GroupId } from '../../lib/taxonomy';
import pandanganData from '../../data/peta/pandangan.json';
import { FORECAST_AXIS, POLICY_STANCE_LABELS, SOURCE_KIND_LABELS, forecastBar, yearToAxisPercent, type Pandangan } from '../../lib/pandangan';

const terms = await getTerms();
const titleOf = new Map(terms.map((term) => [term.slug, term.title]));
const placed = placeMilestones(tonggak as Milestone[]);

// Data yang dipakai panel detail di browser (semua teks sudah final).
const view = placed.map((item) => ({
  id: item.id,
  date: formatMilestoneDate(item.date),
  track: item.track,
  trackLabel: TRACKS.find((track) => track.id === item.track)!.label,
  title: item.title,
  summary: item.summary,
  actors: item.actors,
  sources: item.sources,
  related: item.related.filter((slug) => titleOf.has(slug)).map((slug) => ({ title: titleOf.get(slug)!, href: termUrl(slug) }))
}));

const lanes = TRACKS.map((track) => {
  const items = placed.filter((item) => item.track === track.id);
  return { ...track, items, rows: Math.max(1, ...items.map((item) => item.row + 1)) };
});
const trackCounts = Object.fromEntries(TRACKS.map((track) => [track.id, placed.filter((item) => item.track === track.id).length]));

// Panel progres ensiklopedia.
const statuses = Object.keys(STATUS_LABELS) as TermStatus[];
const countBy = (slugs: string[]) => {
  const subset = terms.filter((term) => slugs.includes(term.category));
  return { total: subset.length, status: Object.fromEntries(statuses.map((s) => [s, subset.filter((term) => term.data.status === s).length])) as Record<TermStatus, number>, sourced: subset.filter((term) => term.data.sources.length > 0).length };
};
const progressRows = [
  ...categoriesOfGroup('ai-si').map((category) => ({ label: category.title, ...countBy([category.slug]) })),
  { label: 'Alat dan platform AI', ...countBy(categoriesOfGroup('alat-ai').map((c) => c.slug)) },
  { label: 'Pengembangan perangkat lunak', ...countBy(categoriesOfGroup('perangkat-lunak').map((c) => c.slug)) }
];
const totals = countBy(CATEGORIES.map((category) => category.slug));
const reviewed = totals.status.ditinjau + totals.status.terverifikasi;
// Matriks tingkat kemampuan (kerangka Levels of AGI).
const framework = levelsData as AgiFramework;
const columns: Column[] = ['sempit', 'umum'];
const lvView = {
  levels: framework.levels,
  otonomi: framework.otonomi,
  penilaian: framework.penilaianPenulis,
  columnLabels: COLUMN_LABELS
};

// Grafik konsep: simpul = entri yang punya hubungan, sisi = "istilah terkait".
// Dua tata letak: "inti" (tanpa istilah perangkat lunak, tampilan awal) dan "penuh" (semua kelompok),
// supaya titik-titik AI tidak tertekan ke satu sudut oleh puluhan istilah perangkat lunak.
const graph = buildGraph(terms);
const termBySlug = new Map(terms.map((term) => [term.slug, term]));
const GRAPH_W = 1000;
const GRAPH_H = 640;
const groupOf = (slug: string) => getCategory(termBySlug.get(slug)!.category)!.group;
const coreEdges = graph.edges.filter(([a, b]) => groupOf(a) !== 'perangkat-lunak' && groupOf(b) !== 'perangkat-lunak');
const coreIds = [...new Set(coreEdges.flat())].sort();
const toLayoutNode = (id: string) => ({ id, cluster: termBySlug.get(id)!.category });
const layoutFull = layoutGraph(graph.connected.map(toLayoutNode), graph.edges, { width: GRAPH_W, height: GRAPH_H, iterations: 320, seed: 11 });
const layoutCore = layoutGraph(coreIds.map(toLayoutNode), coreEdges, { width: GRAPH_W, height: GRAPH_H, iterations: 320, seed: 5 });
const coreSet = new Set(coreIds);
const initialPoint = (id: string) => layoutCore.get(id) ?? layoutFull.get(id)!;
const neighbors = new Map<string, string[]>(graph.connected.map((id) => [id, []]));
for (const [a, b] of graph.edges) { neighbors.get(a)!.push(b); neighbors.get(b)!.push(a); }
const gnodes = graph.connected.map((id) => {
  const term = termBySlug.get(id)!;
  const category = getCategory(term.category)!;
  const point = initialPoint(id);
  const degree = graph.degree.get(id)!;
  return {
    id, title: term.title, summary: term.summary, href: termUrl(id),
    categoryTitle: category.title, group: category.group,
    x: point.x, y: point.y, r: Math.round(Math.min(15, 5 + 2 * Math.sqrt(degree)) * 10) / 10, degree,
    off: !coreSet.has(id),
    neighbors: neighbors.get(id)!.sort((x, y) => termBySlug.get(x)!.title.localeCompare(termBySlug.get(y)!.title, 'id'))
  };
});
const groupCounts = Object.fromEntries(GROUPS.map((group) => [group.id, gnodes.filter((node) => node.group === group.id).length])) as Record<GroupId, number>;
const graphView = gnodes.map(({ id, title, summary, href, categoryTitle, group, neighbors: near }) => ({
  id, title, summary, href, categoryTitle, group,
  aliases: termBySlug.get(id)!.aliases,
  core: layoutCore.get(id) ?? null,
  full: layoutFull.get(id)!,
  neighbors: near.map((slug) => ({ id: slug, title: termBySlug.get(slug)!.title }))
}));

// Peta pandangan: perkiraan waktu, spektrum sikap, usulan kebijakan, survei.
const pandangan = pandanganData as Pandangan;
const forecastRows = pandangan.prakiraan.map((item) => ({ ...item, bar: forecastBar(item) }));
const barStyle = (bar: ReturnType<typeof forecastBar>) => `--a:${bar.start}%;--b:${bar.end}%`;
const policyRows = pandangan.kebijakan.usulan.map((proposal) => ({
  ...proposal,
  cells: pandangan.kebijakan.kolom.map((column) => proposal.posisi.find((position) => position.tokoh === column) ?? null)
}));
const munk = pandangan.survei.munk;
const editData = `${SITE.repo}/edit/main/src/data/peta/tonggak.json`;
const editPandangan = `${SITE.repo}/edit/main/src/data/peta/pandangan.json`;
const jumps = [
  { label: '1950-an', percent: 0 },
  { label: '1990-an', percent: yearToPercent(1993) },
  { label: '2010-an', percent: yearToPercent(2012) },
  { label: '2020 – kini', percent: yearToPercent(2022) }
];
---
<BaseLayout title="Peta menuju superintelligence" description="Dashboard interaktif: linimasa gagasan, model, risiko, dan kebijakan AI dari 1950 hingga 2026, peta pandangan para tokoh, dan grafik konsep; setiap titiknya bertanggal dan bersumber.">
  <header class="enc-hero shell">
    <ol class="crumbs"><li><a href={indexUrl()}>Ensiklopedia</a></li><li aria-current="page">Peta menuju SI</li></ol>
    <p class="kicker">Peta interaktif</p>
    <h1>Peta menuju superintelligence</h1>
    <p class="lede">Dari gagasan “mesin berpikir” pada 1950 sampai laporan keselamatan AI internasional 2026: tonggak riset, model, risiko, dan tata kelola, masing-masing bertanggal dan bersumber.</p>
    <p class="si-note">Tonggak dipilih demi kejelasan, bukan kelengkapan, dan ringkasannya ditulis ulang dari sumber yang tercantum. Untuk perkiraan waktu atau penilaian risiko, yang ditampilkan adalah <strong>pandangan pihak tertentu</strong>, bukan fakta. Ada yang keliru atau terlewat? <a href={editData} rel="noopener noreferrer">Usulkan perbaikan di GitHub</a>.</p>
  </header>

  <nav class="shell peta-nav" aria-label="Bagian halaman">
    <a href="#linimasa">Linimasa</a>
    <a href="#tingkat">Tingkat kemampuan</a>
    <a href="#pandangan">Peta pandangan</a>
    <a href="#graf">Grafik konsep</a>
    <a href="#progres">Progres ensiklopedia</a>
  </nav>

  <section id="linimasa" class="shell peta-section" aria-labelledby="linimasa-judul">
    <p class="kicker">{placed.length} tonggak</p>
    <h2 id="linimasa-judul">Linimasa</h2>
    <p class="peta-lede">Klik sebuah titik untuk membaca ringkasan dan sumbernya. Saat sebuah titik terfokus, tombol panah kiri dan kanan berpindah ke tonggak berikutnya.</p>

    <div class="tl-controls">
      <div class="tl-chips" role="group" aria-label="Saring menurut jalur">
        {TRACKS.map((track) => (
          <button class="tl-chip" type="button" data-track={track.id} aria-pressed="true"><span class={`tl-shape shape-${track.id}`} aria-hidden="true"></span>{track.label} <small>{trackCounts[track.id]}</small></button>
        ))}
        <button class="tl-chip tl-reset" type="button" id="tl-reset" hidden>Tampilkan semua jalur</button>
      </div>
      <div class="tl-jumps" role="group" aria-label="Loncat ke masa">
        {jumps.map((jump) => <button class="tl-jump" type="button" data-jump={jump.percent}>{jump.label}</button>)}
      </div>
    </div>

    <div class="tl-scroll" id="tl-scroll" tabindex="0" role="region" aria-label="Linimasa tonggak AI. Geser ke samping untuk melihat masa lain.">
      <div class="tl-board">
        <div class="tl-axis" aria-hidden="true">
          {AXIS_TICKS.map((year) => <span class="tl-tick" style={`--k:${yearToPercent(year) / 100}`}>{year}</span>)}
        </div>
        {lanes.map((lane) => (
          <div class="tl-lane" data-track={lane.id} style={`--rows:${lane.rows}`} role="group" aria-label={lane.label}>
            <span class="tl-lane-label"><span class={`tl-shape shape-${lane.id}`} aria-hidden="true"></span>{lane.label}</span>
            {lane.items.map((item) => (
              <button class={`tl-dot shape-${lane.id}`} type="button" data-id={item.id} style={`--k:${item.percent / 100};--row:${item.row}`} aria-label={`${formatMilestoneDate(item.date)}: ${item.title}`} title={`${formatMilestoneDate(item.date)}: ${item.title}`}></button>
            ))}
          </div>
        ))}
      </div>
    </div>
    <p class="tl-hint" aria-hidden="true">← geser ke samping →</p>

    <section class="tl-detail" id="tl-detail" aria-live="polite" aria-label="Detail tonggak terpilih">
      <p class="tl-detail-empty">Pilih sebuah titik pada linimasa untuk melihat detailnya di sini.</p>
    </section>

    <h3 class="tl-list-title">Daftar kronologis</h3>
    <p class="peta-lede">Isi yang sama dalam bentuk daftar, termasuk untuk pembaca layar dan saat JavaScript tidak aktif.</p>
    <ol class="tl-list" id="tl-list">
      {placed.map((item, index) => (
        <li id={`tonggak-${item.id}`} data-id={item.id} data-track={item.track}>
          <article>
            <p class="tl-meta"><time>{formatMilestoneDate(item.date)}</time> · <span>{TRACKS.find((track) => track.id === item.track)!.label}</span></p>
            <h4>{item.title}</h4>
            <p>{item.summary}</p>
            <p class="tl-actors"><strong>Tokoh dan lembaga:</strong> {item.actors.join(', ')}</p>
            <ul class="tl-sources">{item.sources.map((source) => <li><a href={source.url} rel="noopener noreferrer">{source.title}</a></li>)}</ul>
            {view[index].related.length > 0 && <ul class="chips">{view[index].related.map((related) => <li><a href={related.href}>{related.title}</a></li>)}</ul>}
          </article>
        </li>
      ))}
    </ol>
  </section>

  <section id="tingkat" class="shell peta-section" aria-labelledby="tingkat-judul">
    <p class="kicker">Kerangka Levels of AGI</p>
    <h2 id="tingkat-judul">Tingkat kemampuan menuju AGI</h2>
    <p class="peta-lede">Kerangka ini mengukur dua hal sekaligus: <strong>kinerja</strong> (seberapa baik, dibandingkan orang dewasa yang terampil) dan <strong>generalitas</strong> (seberapa luas rentang tugasnya). Ini satu usulan dari para peneliti Google DeepMind, bukan kesepakatan baku; definisi AGI sendiri masih diperdebatkan (lihat sembilan pendekatan di bawah). Pilih sel untuk melihat contohnya.</p>

    <div class="lv-wrap">
      <table class="lv-table">
        <caption class="sr-only">Matriks tingkat kinerja (baris) menurut AI sempit dan AI umum (kolom)</caption>
        <thead><tr><th scope="col">Tingkat kinerja</th>{columns.map((column) => <th scope="col">{COLUMN_LABELS[column]}</th>)}</tr></thead>
        <tbody>
          {framework.levels.map((level) => (
            <tr>
              <th scope="row"><span class="lv-num">Level {level.level}</span> <strong>{level.nama}</strong><small>{level.kriteria}</small></th>
              {columns.map((column) => {
                const cell = level[column];
                const frontier = level.level === FRONTIER_CELL.level && column === FRONTIER_CELL.column;
                return (
                  <td>
                    <button type="button" class={`lv-cell${cell.tercapai ? '' : ' is-missing'}${frontier ? ' is-frontier' : ''}`} data-level={level.level} data-column={column} aria-pressed="false">
                      <strong>{cell.label}</strong>
                      <span>{cell.tercapai ? (cell.contoh[0] ?? '') : 'Belum tercapai (menurut tabel penulis)'}</span>
                      {frontier && <em>Posisi model bahasa terdepan, penilaian penulis per September 2023</em>}
                    </button>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <section class="tl-detail" id="lv-detail" aria-live="polite" aria-label="Detail sel terpilih">
      <p class="tl-detail-empty">Pilih sebuah sel pada matriks untuk melihat contoh sistemnya.</p>
    </section>
    <p class="lv-note">{framework.penilaianPenulis} Sumber: <a href={framework.sumber.url} rel="noopener noreferrer">{framework.sumber.title}</a>.</p>

    <h3 class="sub-title">Tingkat otonomi</h3>
    <p class="peta-lede">Dimensi terpisah dari kerangka yang sama: seberapa besar kendali diserahkan kepada AI dalam interaksi dengan manusia.</p>
    <ol class="au-steps">
      {framework.otonomi.map((item) => (
        <li><button type="button" class="au-step" data-level={item.level} aria-pressed="false"><span>Level {item.level}</span><strong>{item.nama}</strong></button></li>
      ))}
    </ol>
    <section class="tl-detail" id="au-detail" aria-live="polite" aria-label="Detail tingkat otonomi terpilih">
      <p class="tl-detail-empty">Pilih sebuah tingkat otonomi untuk melihat deskripsi dan contohnya.</p>
    </section>

    <h3 class="sub-title">Apa itu AGI? Sembilan pendekatan</h3>
    <p class="peta-lede">Para penulis kerangka ini meninjau sembilan definisi atau pendekatan yang pernah diajukan. Uraian di bawah merangkum tinjauan mereka, termasuk kritik mereka sendiri, bukan penilaian situs ini. Buka tiap kartu untuk membacanya.</p>
    <div class="def-grid">
      {framework.definisi.map((item, index) => (
        <details class="def-card">
          <summary><span class="def-no">{index + 1}</span><span><strong>{item.nama}</strong><small>{item.dikaitkan}</small></span></summary>
          <p><strong>Gagasan:</strong> {item.gagasan}</p>
          <p><strong>Kritik penulis kerangka:</strong> {item.kritik}</p>
        </details>
      ))}
    </div>
    <h3 class="sub-title">Enam prinsip penulis untuk mendefinisikan AGI</h3>
    <ol class="prinsip-list">
      {framework.prinsip.map((item) => <li><strong>{item.judul}.</strong> {item.isi}</li>)}
    </ol>
  </section>

  <section id="pandangan" class="shell peta-section" aria-labelledby="pandangan-judul">
    <p class="kicker">Pandangan bertanggal dan bersumber</p>
    <h2 id="pandangan-judul">Peta pandangan</h2>
    <p class="peta-lede">Para tokoh dan lembaga tidak sepakat tentang <strong>kapan</strong> AI setingkat manusia tiba, <strong>seberapa besar</strong> risikonya, dan <strong>apa</strong> yang perlu dilakukan. Bagian ini memetakan perbedaan itu tanpa memihak: setiap entri menyebut nama, tanggal, definisi yang dipakai, dan sumbernya. Ini <strong>pandangan pihak tertentu pada tanggal tertentu</strong>, bukan fakta, dan bisa berubah. {pandangan.catatan} Terakhir diperiksa {pandangan.diperiksaPada}. Ada yang keliru? <a href={editPandangan} rel="noopener noreferrer">Usulkan perbaikan di GitHub</a>.</p>

    <h3 class="sub-title">1. Perkiraan waktu</h3>
    <p class="peta-lede">Angka tahun di bawah <strong>tidak sebanding</strong> satu sama lain: setiap tokoh memakai definisi yang berbeda (AGI, “powerful AI”, singularitas, atau risiko besar). Baca definisinya di tiap baris sebelum membandingkan. Rentang “x tahun lagi” dihitung dari tanggal pernyataannya.</p>
    <div class="fc-chart" role="group" aria-label="Grafik perkiraan waktu menurut tokoh, 2025 sampai 2050">
      <div class="fc-axis" aria-hidden="true">
        {FORECAST_AXIS.ticks.map((year) => <span class="fc-tick" style={`--k:${yearToAxisPercent(year)}%`}>{year}</span>)}
      </div>
      <ol class="fc-list">
        {forecastRows.map((row) => (
          <li class="fc-row">
            <div class="fc-head">
              <strong>{row.tokoh}</strong>
              <small>{row.lembaga}</small>
            </div>
            <div class="fc-track" style={barStyle(row.bar)}>
              <span class={`fc-mark fc-${row.jenis}${row.bar.clipped ? ' is-clipped' : ''}`} aria-hidden="true"></span>
            </div>
            <p class="fc-label"><strong>{row.label}</strong> · dinyatakan {row.tanggal}</p>
            <details class="fc-more">
              <summary>Definisi dan sumber</summary>
              <p><strong>Definisi yang dipakai:</strong> {row.definisi}</p>
              <p>{row.ringkasan}</p>
              <p class="src-line">Sumber: <a href={row.sumber.url} rel="noopener noreferrer">{row.sumber.title}</a> <span class={`src-kind kind-${row.sumber.jenis}`}>{SOURCE_KIND_LABELS[row.sumber.jenis]}</span></p>
            </details>
          </li>
        ))}
      </ol>
      <p class="fc-legend" aria-hidden="true"><span class="fc-key fc-titik"></span> tahun tertentu <span class="fc-key fc-rentang"></span> rentang <span class="fc-key fc-paling-cepat"></span> paling cepat (terbuka ke kanan) <span class="fc-key fc-sebelum"></span> sebelum batas</p>
    </div>

    <h4 class="mini-title">Tidak memberi angka tahun</h4>
    <ul class="noangka-list">
      {pandangan.tanpaAngka.map((item) => (
        <li>
          <strong>{item.tokoh}</strong> <small>({item.tanggal})</small>
          <p>{item.ringkasan}</p>
          <p class="src-line">Sumber: <a href={item.sumber.url} rel="noopener noreferrer">{item.sumber.title}</a> <span class={`src-kind kind-${item.sumber.jenis}`}>{SOURCE_KIND_LABELS[item.sumber.jenis]}</span></p>
        </li>
      ))}
    </ul>

    <h3 class="sub-title">2. Spektrum sikap terhadap risiko</h3>
    <p class="peta-lede">{pandangan.sikap.kriteria}</p>
    <ol class="sp-list">
      {pandangan.sikap.kelompok.map((group, index) => (
        <li class="sp-group">
          <h4><span class="sp-no">{index + 1}</span>{group.judul}</h4>
          <ul class="sp-people">
            {group.tokoh.map((person) => (
              <li>
                <details>
                  <summary><strong>{person.nama}</strong> <small>{person.tanggal}</small></summary>
                  <p>{person.pernyataan}</p>
                  <p class="src-line">Sumber: <a href={person.sumber.url} rel="noopener noreferrer">{person.sumber.title}</a> <span class={`src-kind kind-${person.sumber.jenis}`}>{SOURCE_KIND_LABELS[person.sumber.jenis]}</span></p>
                </details>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
    <p class="lv-note">{pandangan.sikap.belumDitempatkan}</p>

    <h3 class="sub-title">3. Usulan kebijakan</h3>
    <p class="peta-lede">{pandangan.kebijakan.catatan}</p>
    <div class="lv-wrap">
      <table class="pk-table">
        <caption class="sr-only">Sikap tokoh terhadap usulan kebijakan AI</caption>
        <thead><tr><th scope="col">Usulan</th>{pandangan.kebijakan.kolom.map((name) => <th scope="col">{name}</th>)}</tr></thead>
        <tbody>
          {policyRows.map((row) => (
            <tr>
              <th scope="row"><strong>{row.judul}</strong><small>{row.penjelasan}</small></th>
              {row.cells.map((cell) => (
                <td>
                  {cell ? (
                    <details class={`pk-cell pk-${cell.sikap}`}>
                      <summary><span class="pk-badge">{POLICY_STANCE_LABELS[cell.sikap]}</span></summary>
                      <p>{cell.ringkasan}</p>
                      <p class="src-line"><a href={cell.sumber.url} rel="noopener noreferrer">{cell.sumber.title}</a> <span class={`src-kind kind-${cell.sumber.jenis}`}>{SOURCE_KIND_LABELS[cell.sumber.jenis]}</span></p>
                    </details>
                  ) : <span class="pk-empty">Belum diperiksa</span>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h3 class="sub-title">4. Data survei dan debat publik</h3>
    <h4 class="mini-title">Survei {pandangan.survei.grace.responden.toLocaleString('id-ID')} peneliti AI</h4>
    <p class="peta-lede">Grace dkk., terbit {pandangan.survei.grace.terbit}. Angka di bawah adalah agregat jawaban para peneliti yang menerbitkan makalah di forum AI terkemuka, bukan prediksi pasti.</p>
    <dl class="sv-list">
      {pandangan.survei.grace.ringkasan.map((item) => <div><dt>{item.label}</dt><dd>{item.nilai}</dd></div>)}
    </dl>
    <p class="src-line">Sumber: <a href={pandangan.survei.grace.sumber.url} rel="noopener noreferrer">{pandangan.survei.grace.sumber.title}</a> <span class={`src-kind kind-${pandangan.survei.grace.sumber.jenis}`}>{SOURCE_KIND_LABELS[pandangan.survei.grace.sumber.jenis]}</span></p>

    <h4 class="mini-title">{munk.judul}</h4>
    <p class="peta-lede">{munk.waktu}. Pihak pro: {munk.pro.join(' dan ')}. Pihak kontra: {munk.kontra.join(' dan ')}.</p>
    <div class="mk-bars">
      {([['Sebelum debat', munk.sebelum], ['Sesudah debat (hitungan)', munk.sesudah]] as const).map(([label, vote]) => (
        <div class="mk-row">
          <span class="mk-label">{label}</span>
          <span class="mk-bar" role="img" aria-label={`${label}: ${vote.pro}% setuju ada ancaman eksistensial, ${vote.kontra}% tidak setuju`}>
            <span class="mk-pro" style={`width:${vote.pro}%`}>{vote.pro}% pro</span>
            <span class="mk-kontra" style={`width:${vote.kontra}%`}>{vote.kontra}% kontra</span>
          </span>
        </div>
      ))}
    </div>
    <p class="lv-note">{munk.catatan} Sumber: <a href={munk.sumber.url} rel="noopener noreferrer">{munk.sumber.title}</a> ({SOURCE_KIND_LABELS[munk.sumber.jenis]}).</p>
  </section>

  <section id="graf" class="shell peta-section" aria-labelledby="graf-judul">
    <p class="kicker">Jaringan istilah</p>
    <h2 id="graf-judul">Grafik konsep</h2>
    <p class="peta-lede">Setiap titik adalah satu entri ensiklopedia; setiap garis adalah hubungan “istilah terkait”. Pilih titik atau cari istilah untuk menyorot tetangganya. Saat ini {gnodes.length} dari {terms.length} entri sudah terhubung; {graph.isolated.length} lainnya belum punya hubungan dan akan muncul seiring entri ditinjau.</p>

    <div class="tl-controls">
      <div class="tl-chips" role="group" aria-label="Tampilkan kelompok">
        {GROUPS.map((group) => (
          <button class="tl-chip g-chip" type="button" data-group={group.id} aria-pressed={group.id === 'perangkat-lunak' ? 'false' : 'true'}><span class={`g-key g-key-${group.id}`} aria-hidden="true"></span>{group.title} <small>{groupCounts[group.id]}</small></button>
        ))}
      </div>
      <label class="g-search"><span class="sr-only">Cari istilah di grafik</span>
        <input id="g-search" type="search" list="g-terms" placeholder="Cari istilah di grafik…" autocomplete="off" />
        <datalist id="g-terms">{gnodes.flatMap((node) => [node.title, ...termBySlug.get(node.id)!.aliases]).map((name) => <option value={name}></option>)}</datalist>
      </label>
    </div>

    <div class="g-scroll" id="g-scroll" tabindex="0" role="region" aria-label="Grafik konsep. Geser ke samping untuk melihat bagian lain.">
      <svg id="g-svg" class="g-svg" viewBox={`0 0 ${GRAPH_W} ${GRAPH_H}`} role="img" aria-label="Jaringan hubungan antar istilah ensiklopedia. Versi teks tersedia di bawah grafik.">
        <g class="g-edges">
          {graph.edges.map(([a, b]) => <line class={`g-edge${coreSet.has(a) && coreSet.has(b) ? '' : ' is-off'}`} data-a={a} data-b={b} x1={initialPoint(a).x} y1={initialPoint(a).y} x2={initialPoint(b).x} y2={initialPoint(b).y}></line>)}
        </g>
        <g class="g-nodes">
          {gnodes.map((node) => (
            <g class={`g-node${node.degree >= 4 ? ' is-hub' : ''}${node.off || node.group === 'perangkat-lunak' ? ' is-off' : ''}`} data-id={node.id} data-group={node.group} transform={`translate(${node.x} ${node.y})`}>
              <circle r={node.r}></circle>
              <text class="g-label" y={node.r + 14} text-anchor="middle">{node.title}</text>
            </g>
          ))}
        </g>
      </svg>
    </div>
    <p class="tl-hint" aria-hidden="true">← geser ke samping →</p>

    <section class="tl-detail" id="g-detail" aria-live="polite" aria-label="Detail istilah terpilih">
      <p class="tl-detail-empty">Pilih sebuah titik atau cari istilah untuk melihat ringkasannya dan istilah yang terhubung.</p>
    </section>

    <details class="g-text">
      <summary>Daftar hubungan (versi teks)</summary>
      <ul>
        {gnodes.map((node) => (
          <li><a href={node.href}>{node.title}</a>: {node.neighbors.map((slug, i) => <>{i > 0 && ', '}<a href={termUrl(slug)}>{termBySlug.get(slug)!.title}</a></>)}</li>
        ))}
      </ul>
    </details>
  </section>

  <section id="progres" class="shell peta-section" aria-labelledby="progres-judul">
    <p class="kicker">Transparansi</p>
    <h2 id="progres-judul">Progres ensiklopedia</h2>
    <p class="peta-lede">Seberapa matang isi ensiklopedia ini? Semua entri hasil migrasi awal masih berstatus catatan awal; status naik hanya setelah ditinjau dan diberi sumber.</p>
    <dl class="stat-row">
      <div><dt>{totals.total}</dt><dd>entri</dd></div>
      <div><dt>{reviewed}</dt><dd>sudah ditinjau</dd></div>
      <div><dt>{totals.sourced}</dt><dd>punya sumber rujukan</dd></div>
      <div><dt>{placed.length}</dt><dd>tonggak bersumber di peta</dd></div>
    </dl>
    <div class="prog-wrap">
      <table class="prog-table">
        <caption class="sr-only">Jumlah entri per kelompok menurut status tinjauan</caption>
        <thead><tr><th scope="col">Kelompok</th><th scope="col">Sebaran status</th>{statuses.map((s) => <th scope="col" class="num">{STATUS_LABELS[s].label}</th>)}<th scope="col" class="num">Total</th></tr></thead>
        <tbody>
          {progressRows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>
                <span class="prog-bar" aria-hidden="true">
                  {statuses.map((s) => row.total > 0 && row.status[s] > 0 && <span class={`seg seg-${s}`} style={`width:${(row.status[s] / row.total) * 100}%`}></span>)}
                </span>
              </td>
              {statuses.map((s) => <td class="num">{row.status[s]}</td>)}
              <td class="num">{row.total === 0 ? '—' : row.total}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="prog-legend" aria-hidden="true">{statuses.map((s) => <li><span class={`seg seg-${s}`}></span>{STATUS_LABELS[s].label}</li>)}</ul>
    <p class="peta-lede">Kelompok yang berisi 0 entri, seperti <a href={indexUrl()}>“Menuju superintelligence”</a>, sedang disusun.</p>
  </section>

  <script is:inline id="lv-data" type="application/json" set:html={jsonForScript(lvView)}></script>
  <script is:inline id="g-data" type="application/json" set:html={jsonForScript(graphView)}></script>
  <script>
    // Matriks tingkat kemampuan dan tingkat otonomi.
    interface Cell { label: string; contoh: string[]; tercapai: boolean }
    interface Level { level: number; nama: string; namaAsli: string; kriteria: string; sempit: Cell; umum: Cell }
    interface Autonomy { level: number; nama: string; namaAsli: string; deskripsi: string; contoh: string[] }
    const lv = JSON.parse(document.getElementById('lv-data')!.textContent || '{}') as { levels: Level[]; otonomi: Autonomy[]; penilaian: string; columnLabels: Record<string, string> };
    const mk = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string) => {
      const node = document.createElement(tag);
      if (text !== undefined) node.textContent = text;
      if (className) node.className = className;
      return node;
    };
    const examples = (items: string[]) => { const ul = mk('ul', undefined, 'tl-sources'); for (const item of items) ul.append(mk('li', item)); return ul; };

    const lvPanel = document.getElementById('lv-detail')!;
    const lvCells = [...document.querySelectorAll<HTMLButtonElement>('.lv-cell')];
    lvCells.forEach((button) => button.addEventListener('click', () => {
      const level = lv.levels[Number(button.dataset.level)];
      const column = button.dataset.column as 'sempit' | 'umum';
      const cell = level[column];
      lvCells.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      lvPanel.replaceChildren(
        mk('p', `Level ${level.level} · ${level.nama} · ${lv.columnLabels[column]}`, 'tl-meta'),
        mk('h4', cell.label),
        mk('p', `Kriteria kinerja: ${level.kriteria}`)
      );
      if (cell.tercapai) { lvPanel.append(mk('p', 'Contoh sistem menurut penulis:'), examples(cell.contoh)); }
      else lvPanel.append(mk('p', 'Menurut tabel penulis, belum ada sistem yang mencapai tingkat ini. Ini penilaian pada saat makalah ditulis, bukan klaim tentang kondisi terkini.'));
      if (button.classList.contains('is-frontier')) lvPanel.append(mk('p', lv.penilaian, 'tl-actors'));
    }));

    const auPanel = document.getElementById('au-detail')!;
    const auSteps = [...document.querySelectorAll<HTMLButtonElement>('.au-step')];
    auSteps.forEach((button) => button.addEventListener('click', () => {
      const item = lv.otonomi[Number(button.dataset.level)];
      auSteps.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      auPanel.replaceChildren(
        mk('p', `Level ${item.level} · ${item.namaAsli}`, 'tl-meta'),
        mk('h4', item.nama),
        mk('p', item.deskripsi),
        mk('p', 'Contoh menurut penulis:'),
        examples(item.contoh)
      );
    }));
  </script>
  <script>
    // Grafik konsep.
    interface Pt { x: number; y: number }
    interface GNode { id: string; title: string; summary: string; href: string; categoryTitle: string; group: string; aliases: string[]; core: Pt | null; full: Pt; neighbors: { id: string; title: string }[] }
    const gdata = JSON.parse(document.getElementById('g-data')!.textContent || '[]') as GNode[];
    const gById = new Map(gdata.map((node) => [node.id, node]));
    const gByTitle = new Map(gdata.flatMap((node) => [node.title, ...node.aliases].map((name) => [name.toLocaleLowerCase('id-ID'), node.id] as [string, string])));
    const svg = document.getElementById('g-svg')!;
    const gScroll = document.getElementById('g-scroll')!;
    const gPanel = document.getElementById('g-detail')!;
    const gSearch = document.getElementById('g-search') as HTMLInputElement;
    const nodeEls = new Map([...svg.querySelectorAll<SVGGElement>('.g-node')].map((el) => [el.dataset.id!, el]));
    const edgeEls = [...svg.querySelectorAll<SVGLineElement>('.g-edge')];
    const gChips = [...document.querySelectorAll<HTMLButtonElement>('.g-chip')];
    const enabled = new Set(gChips.filter((chip) => chip.getAttribute('aria-pressed') === 'true').map((chip) => chip.dataset.group!));
    const gReduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let selected = '';

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string) => {
      const node = document.createElement(tag);
      if (text !== undefined) node.textContent = text;
      if (className) node.className = className;
      return node;
    };

    function focusOn(id: string) {
      const near = new Set<string>(id ? [id, ...gById.get(id)!.neighbors.map((n) => n.id)] : []);
      svg.classList.toggle('has-focus', Boolean(id));
      nodeEls.forEach((node, key) => { node.classList.toggle('is-near', near.has(key)); node.classList.toggle('is-selected', key === id); });
      edgeEls.forEach((edge) => edge.classList.toggle('is-near', Boolean(id) && (edge.dataset.a === id || edge.dataset.b === id)));
    }

    // Tampilan awal memakai tata letak "inti"; menyalakan perangkat lunak beralih ke tata letak "penuh".
    const pointOf = (id: string): Pt | null => { const node = gById.get(id)!; return enabled.has('perangkat-lunak') ? node.full : node.core; };

    function applyGroups() {
      let visible = 0;
      nodeEls.forEach((node, id) => {
        const point = pointOf(id);
        const on = enabled.has(gById.get(id)!.group) && point !== null;
        node.classList.toggle('is-off', !on);
        if (on && point) { node.setAttribute('transform', `translate(${point.x} ${point.y})`); visible++; }
      });
      edgeEls.forEach((edge) => {
        const from = pointOf(edge.dataset.a!); const to = pointOf(edge.dataset.b!);
        const on = enabled.has(gById.get(edge.dataset.a!)!.group) && enabled.has(gById.get(edge.dataset.b!)!.group) && from !== null && to !== null;
        edge.classList.toggle('is-off', !on);
        if (on && from && to) { edge.setAttribute('x1', String(from.x)); edge.setAttribute('y1', String(from.y)); edge.setAttribute('x2', String(to.x)); edge.setAttribute('y2', String(to.y)); }
      });
      svg.classList.toggle('labels-all', visible <= 60);
      gChips.forEach((chip) => chip.setAttribute('aria-pressed', String(enabled.has(chip.dataset.group!))));
    }

    function renderPanel(node: GNode) {
      gPanel.replaceChildren(
        el('p', node.categoryTitle, 'tl-meta'),
        el('h4', node.title),
        el('p', node.summary)
      );
      const open = el('p'); const link = el('a', 'Buka halaman entri'); link.href = node.href; open.append(link); gPanel.append(open);
      gPanel.append(el('p', `Terhubung dengan ${node.neighbors.length} istilah:`, 'tl-actors'));
      const list = el('ul', undefined, 'chips');
      for (const neighbor of node.neighbors) {
        const li = el('li'); const button = el('button', neighbor.title, 'chip-button'); button.type = 'button';
        button.addEventListener('click', () => select(neighbor.id));
        li.append(button); list.append(li);
      }
      gPanel.append(list);
    }

    function select(id: string) {
      const node = gById.get(id);
      if (!node) return;
      if (!enabled.has(node.group)) enabled.add(node.group);
      if (pointOf(id) === null) enabled.add('perangkat-lunak');
      applyGroups();
      selected = id;
      focusOn(id);
      renderPanel(node);
      const target = nodeEls.get(id)!;
      const box = target.getBoundingClientRect(); const area = gScroll.getBoundingClientRect();
      gScroll.scrollTo({ left: Math.max(0, gScroll.scrollLeft + (box.left - area.left) - gScroll.clientWidth / 2), behavior: gReduce ? 'auto' : 'smooth' });
    }

    nodeEls.forEach((node, id) => {
      node.addEventListener('click', () => select(id));
      node.addEventListener('pointerenter', (event) => { if ((event as PointerEvent).pointerType === 'mouse') focusOn(id); });
      node.addEventListener('pointerleave', (event) => { if ((event as PointerEvent).pointerType === 'mouse') focusOn(selected); });
    });
    gChips.forEach((chip) => chip.addEventListener('click', () => {
      const group = chip.dataset.group!;
      if (enabled.has(group)) enabled.delete(group); else enabled.add(group);
      applyGroups();
      if (selected && !enabled.has(gById.get(selected)!.group)) { selected = ''; focusOn(''); gPanel.replaceChildren(el('p', 'Pilih sebuah titik atau cari istilah untuk melihat ringkasannya dan istilah yang terhubung.', 'tl-detail-empty')); }
    }));
    gSearch.addEventListener('input', () => {
      const id = gByTitle.get(gSearch.value.trim().toLocaleLowerCase('id-ID'));
      if (id) select(id);
    });
    applyGroups();
  </script>
  <script is:inline id="tl-data" type="application/json" set:html={jsonForScript(view)}></script>
  <script>
    interface Related { title: string; href: string }
    interface Item { id: string; date: string; track: string; trackLabel: string; title: string; summary: string; actors: string[]; sources: { title: string; url: string }[]; related: Related[] }
    const data: Item[] = JSON.parse(document.getElementById('tl-data')!.textContent || '[]');
    const byId = new Map(data.map((item) => [item.id, item]));
    const scroller = document.getElementById('tl-scroll')!;
    const panel = document.getElementById('tl-detail')!;
    const dots = new Map([...document.querySelectorAll<HTMLButtonElement>('.tl-dot')].map((dot) => [dot.dataset.id!, dot]));
    const listItems = [...document.querySelectorAll<HTMLElement>('#tl-list > li')];
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.tl-chip[data-track]')];
    const reset = document.getElementById('tl-reset') as HTMLButtonElement;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const active = new Set(chips.map((chip) => chip.dataset.track!));
    let current = '';

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text?: string, className?: string) => {
      const node = document.createElement(tag);
      if (text !== undefined) node.textContent = text;
      if (className) node.className = className;
      return node;
    };

    function render(item: Item) {
      panel.replaceChildren();
      const meta = el('p', `${item.date} · ${item.trackLabel}`, 'tl-meta');
      const heading = el('h4', item.title);
      const summary = el('p', item.summary);
      const actors = el('p', undefined, 'tl-actors'); actors.append(el('strong', 'Tokoh dan lembaga: '), document.createTextNode(item.actors.join(', ')));
      const sources = el('ul', undefined, 'tl-sources');
      for (const source of item.sources) { const li = el('li'); const a = el('a', source.title); a.href = source.url; a.rel = 'noopener noreferrer'; li.append(a); sources.append(li); }
      panel.append(meta, heading, summary, actors, sources);
      if (item.related.length) {
        const chipList = el('ul', undefined, 'chips');
        for (const related of item.related) { const li = el('li'); const a = el('a', related.title); a.href = related.href; li.append(a); chipList.append(li); }
        panel.append(chipList);
      }
    }

    function select(id: string, options: { focus?: boolean } = {}) {
      const item = byId.get(id); const dot = dots.get(id);
      if (!item || !dot || dot.hidden) return;
      current = id;
      dots.forEach((other) => other.removeAttribute('aria-current'));
      dot.setAttribute('aria-current', 'true');
      listItems.forEach((li) => li.classList.toggle('is-active', li.dataset.id === id));
      render(item);
      history.replaceState(null, '', `#tonggak-${id}`);
      const target = dot.offsetLeft - scroller.clientWidth / 2;
      scroller.scrollTo({ left: Math.max(0, target), behavior: reduce ? 'auto' : 'smooth' });
      if (options.focus) dot.focus({ preventScroll: true });
    }

    const visibleIds = () => data.filter((item) => active.has(item.track)).map((item) => item.id);

    function applyFilter() {
      dots.forEach((dot, id) => { dot.hidden = !active.has(byId.get(id)!.track); });
      listItems.forEach((li) => { li.hidden = !active.has(li.dataset.track!); });
      document.querySelectorAll<HTMLElement>('.tl-lane').forEach((lane) => { lane.hidden = !active.has(lane.dataset.track!); });
      chips.forEach((chip) => chip.setAttribute('aria-pressed', String(active.has(chip.dataset.track!))));
      reset.hidden = active.size === chips.length;
      if (current && !active.has(byId.get(current)!.track)) { current = ''; panel.replaceChildren(el('p', 'Pilih sebuah titik pada linimasa untuk melihat detailnya di sini.', 'tl-detail-empty')); }
    }

    dots.forEach((dot, id) => {
      dot.addEventListener('click', () => select(id));
      dot.addEventListener('keydown', (event) => {
        const ids = visibleIds(); const index = ids.indexOf(id);
        const move = event.key === 'ArrowRight' ? index + 1 : event.key === 'ArrowLeft' ? index - 1 : event.key === 'Home' ? 0 : event.key === 'End' ? ids.length - 1 : null;
        if (move === null || !ids.length) return;
        event.preventDefault();
        select(ids[Math.min(ids.length - 1, Math.max(0, move))], { focus: true });
      });
    });

    chips.forEach((chip) => chip.addEventListener('click', () => {
      const track = chip.dataset.track!;
      if (active.has(track)) active.delete(track); else active.add(track);
      applyFilter();
    }));
    reset.addEventListener('click', () => { chips.forEach((chip) => active.add(chip.dataset.track!)); applyFilter(); });

    document.querySelectorAll<HTMLButtonElement>('.tl-jump').forEach((button) => button.addEventListener('click', () => {
      const board = scroller.firstElementChild as HTMLElement;
      const left = (board.scrollWidth * Number(button.dataset.jump)) / 100 - scroller.clientWidth / 4;
      scroller.scrollTo({ left: Math.max(0, left), behavior: reduce ? 'auto' : 'smooth' });
    }));

    const fromHash = decodeURIComponent(location.hash).replace(/^#tonggak-/, '');
    if (byId.has(fromHash)) select(fromHash);
    applyFilter();
  </script>
</BaseLayout>
