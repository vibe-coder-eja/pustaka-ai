---
import { SITE, withBase } from '../lib/site';
import { jsonForScript } from '../lib/json-script';
import '../styles/global.css';
import '../styles/ensiklopedia.css';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}
const { title, description = SITE.description, image = 'og-cover.png', noindex = false, jsonLd } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const base = import.meta.env.BASE_URL;
const home = withBase(base);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(withBase(base, image), Astro.site);
const searchIndexUrl = withBase(base, 'search-index.json');
---
<!doctype html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#f7f1e5" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: ${SITE.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    {noindex && <meta name="robots" content="noindex,follow" />}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonForScript(jsonLd)} />}
    <link rel="icon" href={withBase(base, 'favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase(base, 'apple-touch-icon.png')} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try {
          const p = JSON.parse(localStorage.getItem('pustaka:preferences') || 'null') || {};
          const theme = ['light', 'dark', 'system'].includes(p.theme) ? p.theme : 'system';
          const resolved = theme === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : theme;
          document.documentElement.dataset.theme = resolved;
          document.documentElement.dataset.themePreference = theme;
          document.documentElement.style.setProperty('--font-scale', String(Math.min(1.2, Math.max(.9, Number(p.fontScale) || 1))));
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Lewati ke konten utama</a>
    <header class="site-header">
      <a class="brand" href={home} aria-label={`${SITE.name}, beranda`}>
        <LogoMark size={42} />
        <span><strong>{SITE.name}</strong><small>oleh {SITE.author}</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Navigasi utama">
        <a href={withBase(base, 'ensiklopedia/')}>Ensiklopedia</a>
        <a href={withBase(base, 'referensi/')}>Referensi</a>
        <a href={withBase(base, 'tentang/')}>Tentang</a>
      </nav>
      <div class="header-actions">
        <button class="icon-button" id="search-open" type="button" aria-label="Buka pencarian" title="Cari (/) ">⌕</button>
        <button class="icon-button" id="theme-toggle" data-theme-toggle type="button" aria-label="Ubah tema (saat ini: ikuti sistem)" title="Ubah tema">◐</button>
        <button class="icon-button mobile-only" id="menu-toggle" type="button" aria-label="Buka menu" aria-controls="mobile-menu" aria-expanded="false">☰</button>
      </div>
    </header>
    <div id="mobile-menu" class="mobile-menu" hidden>
      <nav aria-label="Navigasi seluler">
        <a href={withBase(base, 'ensiklopedia/')}>Ensiklopedia</a><a href={withBase(base, 'referensi/')}>Referensi</a><a href={withBase(base, 'tentang/')}>Tentang</a>
      </nav>
      <button class="mobile-theme-button" id="theme-toggle-mobile" data-theme-toggle type="button">Ubah tema</button>
    </div>

    <main id="main-content"><slot /></main>

    <footer class="site-footer">
      <div><LogoMark size={34} /><p><strong>{SITE.name}</strong><br /><span>{SITE.tagline}</span></p></div>
      <nav aria-label="Tautan footer">
        <a href={SITE.github} rel="me noopener noreferrer">GitHub</a>
        <a href={SITE.website} rel="me noopener noreferrer">Website Reza</a>
        <a href={SITE.discussions} rel="noopener noreferrer">Diskusi</a>
        <a href={withBase(base, 'tentang/#lisensi')}>Lisensi</a>
      </nav>
      <small>Kode MIT · Konten editorial asli CC BY 4.0 · Snapshot pihak ketiga tetap milik pemegang haknya.</small>
    </footer>

    <dialog id="search-dialog" class="search-dialog" aria-labelledby="search-title" data-index-url={searchIndexUrl}>
      <form method="dialog" class="search-head">
        <label id="search-title" for="global-search">Cari di seluruh pustaka</label>
        <button class="icon-button" value="cancel" aria-label="Tutup pencarian">×</button>
      </form>
      <input id="global-search" type="search" autocomplete="off" placeholder="Contoh: agent, keamanan, image…" />
      <p class="search-hint">Ketik minimal 2 karakter · <kbd>↓</kbd> <kbd>↑</kbd> untuk memilih hasil · <kbd>Esc</kbd> untuk menutup</p>
      <ol id="search-results" class="search-results" aria-live="polite"></ol>
    </dialog>
    <script>
      const root = document.documentElement;
      const dialog = document.querySelector<HTMLDialogElement>('#search-dialog')!;
      const input = document.querySelector<HTMLInputElement>('#global-search')!;
      const results = document.querySelector<HTMLOListElement>('#search-results')!;
      type Entry = { type: string; title: string; text: string; href: string };
      let index: Entry[] | null = null;
      let loading: Promise<Entry[] | null> | null = null;
      const loadIndex = () => {
        if (index) return Promise.resolve(index);
        loading ??= fetch(dialog.dataset.indexUrl!)
          .then((response) => { if (!response.ok) throw new Error(String(response.status)); return response.json() as Promise<Entry[]>; })
          .then((data) => (index = data))
          .catch(() => { loading = null; return null; });
        return loading;
      };
      const normalize = (value: string) => value.normalize('NFKD').replace(/[̀-ͯ]/g, '').toLocaleLowerCase('id-ID');
      const message = (text: string) => { const li = document.createElement('li'); li.className = 'empty'; li.textContent = text; results.replaceChildren(li); };
      const openSearch = () => { input.value = ''; results.replaceChildren(); dialog.showModal(); setTimeout(() => input.focus(), 0); void loadIndex(); };
      document.querySelector('#search-open')?.addEventListener('click', openSearch);
      document.addEventListener('keydown', (event) => {
        const target = event.target as HTMLElement;
        const typing = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || target.isContentEditable;
        if (event.key === '/' && !typing && !event.ctrlKey && !event.metaKey && !event.altKey) { event.preventDefault(); openSearch(); }
      });
      const links = () => [...results.querySelectorAll<HTMLAnchorElement>('a')];
      dialog.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
        const items = links(); if (!items.length) return;
        const current = items.indexOf(document.activeElement as HTMLAnchorElement);
        const next = event.key === 'ArrowDown' ? current + 1 : current - 1;
        event.preventDefault();
        if (next < 0) input.focus(); else items[Math.min(next, items.length - 1)].focus();
      });
      let searchTimer = 0;
      input.addEventListener('input', () => {
        clearTimeout(searchTimer);
        searchTimer = window.setTimeout(async () => {
          const query = normalize(input.value.trim()); results.replaceChildren();
          if (query.length < 2) return;
          if (!index) message('Memuat indeks pencarian…');
          const entries = await loadIndex();
          if (normalize(input.value.trim()) !== query) return;
          if (!entries) { message('Indeks pencarian gagal dimuat. Periksa koneksi lalu coba lagi.'); return; }
          const tokens = query.split(/\s+/).filter(Boolean);
          const rank = (item: Entry) => { const title = normalize(item.title); return title.startsWith(query) ? 0 : title.includes(query) ? 1 : tokens.every((token) => title.includes(token)) ? 2 : 3; };
          const matches = entries
            .filter((item) => { const haystack = normalize(`${item.title} ${item.text}`); return tokens.every((token) => haystack.includes(token)); })
            .map((item, order) => ({ item, order, score: rank(item) }))
            .sort((a, b) => a.score - b.score || a.order - b.order)
            .slice(0, 24)
            .map(({ item }) => item);
          results.replaceChildren();
          for (const item of matches) {
            const li = document.createElement('li'); const a = document.createElement('a');
            a.href = item.href; const badge = document.createElement('span'); badge.textContent = item.type;
            const strong = document.createElement('strong'); strong.textContent = item.title;
            const small = document.createElement('small'); small.textContent = item.text;
            a.append(badge, strong, small); li.append(a); results.append(li);
          }
          if (!matches.length) message('Tidak ada hasil yang cocok.');
        }, 150);
      });
      const themeColors: Record<string, string> = { light: '#f7f1e5', dark: '#131622' };
      const themeOrder = ['system', 'light', 'dark'];
      const themeNames: Record<string, string> = { system: 'ikuti sistem', light: 'terang', dark: 'gelap' };
      const labelTheme = () => {
        const label = `Ubah tema (saat ini: ${themeNames[root.dataset.themePreference || 'system']})`;
        document.querySelectorAll('[data-theme-toggle]').forEach((button) => { button.setAttribute('aria-label', label); button.setAttribute('title', label); });
      };
      const cycleTheme = () => {
        const current = root.dataset.themePreference || 'system'; const next = themeOrder[(themeOrder.indexOf(current) + 1) % themeOrder.length];
        const resolved = next === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : next;
        root.dataset.theme = resolved; root.dataset.themePreference = next;
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', themeColors[resolved] || themeColors.light);
        try { const old = JSON.parse(localStorage.getItem('pustaka:preferences') || '{}'); localStorage.setItem('pustaka:preferences', JSON.stringify({ ...old, theme: next })); } catch {}
        labelTheme();
      };
      document.querySelectorAll('[data-theme-toggle]').forEach((button) => button.addEventListener('click', cycleTheme));
      labelTheme();
      const menu = document.querySelector<HTMLElement>('#mobile-menu')!; const menuButton = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const closeMenu = () => { if (menu.hidden) return; menu.hidden = true; menuButton?.setAttribute('aria-expanded', 'false'); if (menuButton) menuButton.textContent = '☰'; };
      menuButton?.addEventListener('click', () => { const open = menu.hidden; menu.hidden = !open; menuButton.setAttribute('aria-expanded', String(open)); menuButton.textContent = open ? '×' : '☰'; });
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('click', (event) => { if (!menu.hidden && !menu.contains(event.target as Node) && event.target !== menuButton) closeMenu(); });
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !menu.hidden) closeMenu(); });
    </script>
  </body>
</html>
